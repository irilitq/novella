extends Control

var texts := [
	"Мы разложили вещи.",
	"Прощай, Ростов.",
	"Мама с папой лежали на нижних койках.",
	"Молчали.",
	"Сестрёнка весело тыкала в телефон на верхней.",
	"Ладно.",
	"Пора отдыхать.",
	"Я и так планировал проспать всю дорогу.",
	"...",
	"Проснулся ближе к шести вечера.",
	"За окном — чужие поля.",
	"Стук колёс.",
	"Чем дальше мы отъезжали, тем меньше мне нравилось.",
	"Матвей: Мам, а где мы сейчас?",
	"Мама: Час назад Лиски проехали.",
	"Мама: Скоро Воронеж.",
	"Воронеж.",
	"Неплохой город.",
	"Матвей: А Брянск скоро?",
	"Мама: Часов через семь после Воронежа.",
	"М-да уж.",
	"Ещё семь часов тут сидеть.",
	"Я уставился в окно.",
	"Поля. Столбы. Провода.",
	"Всё одно и то же.",
	"Интересно, а в Брянске так же?",
	"Или там сразу лес по краям.",
	"Как я и представлял.",
	"Телефон почти сел.",
	"Колька не отвечает.",
	"Наверное, гуляет.",
	"Я посмотрел на индикатор сети",
	"Или не отвечает из-за этого",
	"Сети нет.",
	"А я тут.",
	"Семь часов.",
	"Можно и поспать.",
	"0"
]
var index := 0

@onready var label: Label = $text
@onready var button: Button = $skip
@onready var home: Button = $home

func _ready() -> void:
	label.text = texts[index]

	button.pressed.connect(func():
		index = min(index + 1, texts.size() - 1)
		label.text = texts[index]
		
		# Проверяем ПОСЛЕ обновления текста
		if label.text == "0":
			get_tree().change_scene_to_file("res://scenes/firstChapter/five_scene.tscn")
	)
	
	home.pressed.connect(func():
		get_tree().change_scene_to_file("res://scenes/mainScenes/start_scene.tscn")
	)
	
