extends Control

var texts := [
	"Брянск встретил нас серостью.",
	"Совру, если скажу, что тут легко дышится.",
	"Воздух какой-то другой.",
	"Может, акклиматизация.",
	"И прохладно.",
	"Мы вышли с вокзала Брянск-Орловский.",
	"Напротив — лес.",
	"Кажется, город правда высечен в сердце леса.",
	"...",
	"Через пару минут подъехал папин друг.",
	"Дядя Гриша: Здорово, Семён.",
	"Папа: Привет, Гриша.",
	"Дядя Гриша: Грузитесь быстрее, сейчас ливанёт.",
	"Дядя Гриша: А мокрые вы мне в моей ласточке не нужны.",
	"Дядя Гриша усмехнулся.",
	"...",
	"Мы сели в машину.",
	"Дядя Гриша: Ну рассказывай, Сёма. Чего вернуться-то решили?",
	"Папа: Жизнь она, Гриш, не знаешь, куда тебя завтра закинет.",
	"Папа: Родители сдают здоровьем.",
	"Папа: Вот и решили поближе перебраться.",
	"Дядя Гриша: А. Ну оно и понятно.",
	"Дядя Гриша: Правильно.",
	"Дядя Гриша и папа болтали о своём.",
	"А я смотрел в окно.",
	"И думал о своём будущем.",
	"Что меня тут ждёт — большой вопрос.",
	"...",
	"0"
]
var index := 0

@onready var label: Label = $text
@onready var button: Button = $skip
@onready var home: Button = $home

func _ready() -> void:
	label.text = texts[index]

	button.pressed.connect(func():
		index = min(index + 1, texts.size() - 1)
		label.text = texts[index]
		
		# Проверяем ПОСЛЕ обновления текста
		if label.text == "0":
			get_tree().change_scene_to_file("res://scenes/firstChapter/six_scene.tscn")
	)
	
	home.pressed.connect(func():
		get_tree().change_scene_to_file("res://scenes/mainScenes/start_scene.tscn")
	)
	
