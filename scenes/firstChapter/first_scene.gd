extends Control

var texts := [
	"Был обычный майский день.",
	"Я шёл домой после школы.",
	"Тащился, если честно.",
	"Рюкзак казался чужим.",
	"Тяжёлым, будто кирпичи.",
	"Устал за день.",
	"Коля позвал вечером гулять.",
	"Значит, надо успеть с домашкой.",
	"Сделаю — и свобода.",
	"Хотя бы на пару часов.",
	"А в субботу — с папой на рыбалку.",
	"С удочками, с термосом.",
	"С его вечным «клёв будет, вот увидишь».",
	"На рыбалку...",
	"Давненько был там.",
	"Лет пять, если честно.",
	"Я уже и не помню, как это.",
	"Сидеть на берегу и никуда не торопиться.",
	"Ладно.",
	"Что будет — то будет.",
	"Не мне решать, когда наступит суббота.",
	"Сейчас бы настроиться на проклятую Геометрию.",
	"А не мечтать о выходных.",
	"Теорема за теоремой.",
	"Страница за страницей.",
	"Уже предвкушаю как будут кипеть мозги.",
	"А до субботы дожить надо.",
	"Дожить — это тоже работа.",
	"0"
]
var index := 0

@onready var label: Label = $text
@onready var button: Button = $skip
@onready var home: Button = $home

func _ready() -> void:
	label.text = texts[index]

	button.pressed.connect(func():
		index = min(index + 1, texts.size() - 1)
		label.text = texts[index]
		
		# Проверяем ПОСЛЕ обновления текста
		if label.text == "0":
			get_tree().change_scene_to_file("res://scenes/firstChapter/two_scene.tscn")
	)

	home.pressed.connect(func():
		get_tree().change_scene_to_file("res://scenes/mainScenes/start_scene.tscn")
	)
